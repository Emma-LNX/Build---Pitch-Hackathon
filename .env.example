# Copiar a .env y completar con las credenciales del proyecto.
# Usar la conexion directa o Session pooler (5432) de Supabase.
SUPABASE_DB_URL=jdbc:postgresql://TU_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=TU_USUARIO
SUPABASE_DB_PASSWORD=TU_CONTRASENA

# URL base de Supabase Auth, sin barra final.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Alternativa: SUPABASE_AUTH_ISSUER=https://TU_PROYECTO.supabase.co/auth/v1

# Clave secreta service_role (o secret key) de Supabase: solo backend, nunca en el frontend.
# Sin ella, crear cuentas de alumnos responde 503.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Opcional: SMTP para los reportes de padres. Sin HOST y FROM, el envío devuelve 503.
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USERNAME=
REPORT_SMTP_PASSWORD=
REPORT_SMTP_FROM=
REPORT_SMTP_STARTTLS=true

# Revisión diaria a las 08:00 de Guatemala; se envía una sola vez por semana.
REPORT_WEEKLY_CHECK_CRON="0 0 8 * * *"
REPORT_WEEKLY_ZONE=America/Guatemala
