# Copiar a .env y completar con las credenciales del proyecto.
# Usar la conexion directa o Session pooler (5432) de Supabase.
SUPABASE_DB_URL=jdbc:postgresql://TU_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=TU_USUARIO
SUPABASE_DB_PASSWORD=TU_CONTRASENA

# URL base de Supabase Auth, sin barra final.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Alternativa: SUPABASE_AUTH_ISSUER=https://TU_PROYECTO.supabase.co/auth/v1
