# Copiar a frontend/.env.local y completar. Vite las incrusta al compilar: solo valores públicos.
# Sin ellas la app funciona solo en local y /entrar avisa que el inicio de sesión no está configurado.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave publishable (o anon) del proyecto. NUNCA la service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=TU_PUBLISHABLE_KEY
