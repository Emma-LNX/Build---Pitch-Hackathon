# Copiar a frontend/.env.local para desarrollo. Solo valores PÚBLICOS:
# la URL del proyecto y la clave "anon". Nunca la clave service-role.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON
# Alternativa compatible: VITE_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA
